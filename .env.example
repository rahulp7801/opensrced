# Copy to .env.local and fill in. `cp .env.example .env.local`
#
# Anthropic and Gemini API keys are NOT set here — they're entered in the
# UI (Crucible → API Keys) and stored in an encrypted httpOnly cookie.
# See lib/api-keys.ts. There is no server-side env fallback for them.

# ── Required: auth (Auth0 SDK v4) ─────────────────────────────────────
# Every GitHub operation runs as the logged-in user, so login is required.
AUTH0_SECRET=                 # openssl rand -hex 32 — also encrypts the API-key cookie
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=                 # BARE host, no scheme: dev-xxxx.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
#
# Upgrading from SDK v3? Two vars were renamed:
#   AUTH0_BASE_URL        -> APP_BASE_URL
#   AUTH0_ISSUER_BASE_URL -> AUTH0_DOMAIN   (drop the https:// prefix)
# lib/auth0.ts still reads the old names as a fallback, so an existing
# .env.local keeps working — but update them, the fallback is temporary.
#
# In the Auth0 dashboard the callback paths moved off /api:
#   Allowed Callback URLs -> http://localhost:3000/auth/callback
#   Allowed Logout URLs   -> http://localhost:3000
# Login fails at the tenant, not in this app, if these aren't updated.

# ── Local dev without Auth0 ───────────────────────────────────────────
# Set AUTH_DISABLED=1 to skip all auth checks (middleware AND per-route
# guards). AUTH0_SECRET is still required — it's the encryption key for
# the stored API keys. Supply a token explicitly, since with no session
# there's no GitHub identity to derive one from.
#
# The app REFUSES TO START with AUTH_DISABLED=1 and NODE_ENV=production:
# that combination turns off the middleware gate and every per-route guard
# at once, which nobody sets deliberately in a deployment. GITHUB_TOKEN
# below is honored only while AUTH_DISABLED=1 — there is no env fallback
# for it in normal operation, so a deployed instance can never act as the
# operator on a user's behalf.
# AUTH_DISABLED=1
# GITHUB_TOKEN=

# ── Optional: deterministic dispatch (ContribAI binary) ───────────────
# Without CONTRIBAI_BIN, /api/run/target and /api/run/solve return 501 and
# only the agentic path (claude -p) is available.
# CONTRIBAI_BIN=C:/path/to/contribai.exe
# CONTRIBAI_CONFIG=C:/path/to/config.yaml
# GH_CLI=                     # explicit path to gh; falls back to PATH

# ── Optional: Crucible (private repos via a GitHub App) ───────────────
# Connecting an org requires the caller to prove they ADMINISTER it: the
# install-callback checks /user/memberships/orgs/:org with the caller's own
# GitHub token, which needs the `read:org` scope (requested in lib/auth0.ts
# via connection_scope). Sessions created before that scope was added lack
# it — those users must log out and back in before Connect will work.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY=     # PEM; \n-escaped single line is accepted
# GITHUB_APP_WEBHOOK_SECRET=

# ── Optional: pipeline tuning ─────────────────────────────────────────
# OPENSRCER_RUN_TESTS=crucible   # crucible (default) | all | off
#   Which flows run the TARGET repo's test suite before opening a PR.
#   `all` executes untrusted repo code on this host with no sandbox —
#   only enable it where that's acceptable. See lib/agentic-pr.ts.
# OPENSRCER_GEMINI_GATE=1        # 0 = Gemini review advisory instead of blocking
# OPENSRCER_AGENTIC_BUDGET_USD=2
# OPENSRCER_AGENTIC_LEAF_BUDGET_USD=0.5
# OPENSRCER_AGENTIC_TIMEOUT_MS=1800000
# OPENSRCER_AGENTIC_AUTO_PR=1    # 0 = never auto-open a PR
# OPENSRCER_COMMIT_NAME=
# OPENSRCER_COMMIT_EMAIL=
# OPENSRCER_CACHE_DIR=           # default ~/.contribai/repos

# ── Optional: graph intelligence (code-review-graph) ──────────────────
# Unset = graph features degrade to "unavailable" instead of erroring.
# CRG_PYTHONPATH=
