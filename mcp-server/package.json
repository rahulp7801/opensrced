{
  "name": "opensrcer-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server exposing repo-introspection tools (read/grep/find_definition/find_references) over shallow-cloned repos, used by Claude Code to solve issues on large codebases.",
  "bin": {
    "opensrcer-mcp-server": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "start": "node dist/server.js",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2"
  }
}
