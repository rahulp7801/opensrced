{
  "name": "opensrcer-observatory",
  "version": "1.1.0-beta.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "build:worker": "tsc -p tsconfig.worker.json && node --check scripts/sandbox-worker.cjs && node --check scripts/sandbox-graph.cjs && node --check scripts/sandbox-push.cjs && node --check scripts/sandbox-publish.cjs && node --check scripts/exec-server.cjs && node --check scripts/eval-merged.cjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test .test-build/lib/__tests__/*.test.js",
    "db:migrate": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env.local .test-build/lib/db/migrate.js",
    "catalog:add": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env.local scripts/catalog-add.mjs",
    "calibrate:difficulty": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env.local scripts/calibrate-difficulty.mjs"
  },
  "dependencies": {
    "@actions/expressions": "0.3.61",
    "@actions/workflow-parser": "0.3.61",
    "@auth0/nextjs-auth0": "^4.33.0",
    "@codingame/monaco-editor-wrapper": "35.0.0",
    "@codingame/monaco-vscode-api": "38.1.3",
    "@codingame/monaco-vscode-files-service-override": "38.1.3",
    "@codingame/monaco-vscode-standalone-typescript-language-features": "38.1.3",
    "@electric-sql/pglite-pgvector": "0.0.16",
    "@electric-sql/pglite": "0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-paginate-rest": "^16.0.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "1.6.1",
    "@vercel/blob": "2.8.2",
    "@vercel/sandbox": "3.9.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "botid": "1.5.12",
    "clsx": "^2.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "3.15.1",
    "monaco-pyright-lsp": "0.1.7",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    },
    "zod": "^4.6.6",
    "monaco-pyright-lsp": {
      "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@38.1.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "7.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "playwright": "1.65.0",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3"
  }
}
